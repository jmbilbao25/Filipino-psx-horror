[gd_scene load_steps=13 format=3]

; Shader look test: streetlight pool on dirt, a few props on every Psx kind.
; Depends only on files the shader piece owns.

[ext_resource type="PackedScene" path="res://scenes/psx_rig.tscn" id="1_rig"]
[ext_resource type="Environment" path="res://world/night.tres" id="2_env"]

[sub_resource type="GDScript" id="1_test"]
script/source = "extends Node

## Every MeshInstance3D is named after its Psx kind. uv_scale is derived from the
## mesh size so the 32px textures stay chunky whatever the prop is.
func _ready() -> void:
	for n in ($Rig/World as Node).get_children():
		if n is MeshInstance3D:
			var mi := n as MeshInstance3D
			var m: ShaderMaterial = Psx.mat(mi.name).duplicate()
			m.set_shader_parameter(&\"uv_scale\", maxf(1.0, roundf(mi.get_aabb().size.length() * 0.5)))
			mi.material_override = m
	($Rig as Node).call(&\"set_tension\", 0.0)


func _input(e: InputEvent) -> void:
	if e is InputEventMouseMotion:
		($Rig/World/cam as Camera3D).rotate_y(-(e as InputEventMouseMotion).relative.x * 0.004)
		($Rig as Node).call(&\"set_tension\", 0.55)
"

