[gd_resource type="Environment" format=3]

; Barangay night. Blacks must reach true black, so ambient is fully disabled
; and the only light in the world comes from lamps the player can see.
; The warm amber depth fog is the only thing that lifts a pixel off #000000,
; and it starts far enough out that near geometry stays crushed.
[resource]
background_mode = 1
background_color = Color(0, 0, 0, 1)
ambient_light_source = 1
ambient_light_color = Color(0, 0, 0, 1)
ambient_light_energy = 0.0
ambient_light_sky_contribution = 0.0
reflected_light_source = 0
tonemap_mode = 0
tonemap_exposure = 1.0
tonemap_white = 1.0
ssao_enabled = false
glow_enabled = false
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.13, 0.1, 0.05, 1)
fog_light_energy = 1.0
fog_sun_scatter = 0.0
fog_density = 0.45
fog_aerial_perspective = 0.0
fog_sky_affect = 0.0
fog_depth_curve = 1.6
fog_depth_begin = 6.0
fog_depth_end = 34.0
adjustment_enabled = false
